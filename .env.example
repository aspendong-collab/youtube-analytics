# ========================================
# YouTube API Key 配置
# ========================================
#
# 配置方式有三种（优先级从高到低）：
#
# 方式一：通过界面配置（推荐用于个人使用）
# 1. 启动应用后，访问 "设置管理" > "数据采集"
# 2. 在 "API 配置" 标签页中输入 YouTube API Key
# 3. 点击 "保存配置" 按钮
# 4. 配置会保存在浏览器 Cookie 中，有效期 30 天
#
# 方式二：环境变量配置（推荐用于生产环境/Vercel 部署）
# 1. 复制本文件为 .env.local（本地）或在 Vercel 环境变量中设置
# 2. 将 YouTube API Key 设置到 YOUTUBE_API_KEY 变量
# 3. 重启应用
#
# 方式三：环境变量配置（推荐用于容器化部署）
# 1. 在 Docker 镜像或 Kubernetes 中设置环境变量
# 2. 设置 YOUTUBE_API_KEY 环境变量
#
# 获取 YouTube API Key 的方法：
# 1. 访问 https://console.cloud.google.com/
# 2. 创建新项目或选择现有项目
# 3. 在 "API 和服务" > "库" 中搜索并启用 "YouTube Data API v3"
# 4. 在 "API 和服务" > "凭据" 中创建 API 密钥
# 5. 复制 API 密钥并配置到下方或界面中

YOUTUBE_API_KEY=your_youtube_api_key_here

# ========================================
# 数据库配置（可选）
# ========================================
# 如果需要使用数据库存储数据，请配置以下信息

DATABASE_URL=postgresql://user:password@localhost:5432/youtube_analytics

# ========================================
# 对象存储配置（可选）
# ========================================
# 如果需要使用对象存储，请配置以下信息

S3_BUCKET_NAME=your_bucket_name
S3_REGION=your_region
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
