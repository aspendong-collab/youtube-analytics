# 数据库配置
PGDATABASE_URL=postgresql://username:password@hostname/database?sslmode=require

# YouTube API Key 配置
# 方式1: 单个 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# 方式2: 多个 Key（推荐，自动轮询，总配额 = Key数量 × 10000）
# 格式1: Vercel 风格（推荐）
YOUTUBE_API_KEY_1=your_first_api_key
YOUTUBE_API_KEY_2=your_second_api_key
YOUTUBE_API_KEY_3=your_third_api_key
YOUTUBE_API_KEY_4=your_fourth_api_key
YOUTUBE_API_KEY_5=your_fifth_api_key
# 可以继续添加 YOUTUBE_API_KEY_6, YOUTUBE_API_KEY_7, ...

# 格式2: JSON 数组
YOUTUBE_API_KEYS=["key1","key2","key3"]

# 格式3: 逗号分隔
YOUTUBE_API_KEYS=key1,key2,key3

# 注意：
# - 推荐 Vercel 风格（YOUTUBE_API_KEY_1, YOUTUBE_API_KEY_2, ...），便于在 Vercel 控制台管理
# - 配置多个 Key 时，系统会自动使用 Key 池管理
# - 每个 Key 每天有 10000 配额
# - 系统会智能选择配额最充足的 Key
# - 当某个 Key 配额用完时，自动切换到下一个
# - 支持 4 种选择策略：least-used（默认）, round-robin, priority, random

# NextAuth 配置
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-secret-key-here

# 注意：以上环境变量需要在 Vercel 项目设置中配置
# 1. 打开 Vercel Dashboard
# 2. 选择项目: youtube-analytics
# 3. 进入 Settings > Environment Variables
# 4. 添加上述环境变量
# 5. 重新部署项目
